{
  "name": "myshot",
  "version": "1.4.1",
  "private": true,
  "description": "MyShot – מעקב טיפול בתרופות להרזיה, תזונה ותוספים",
  "scripts": {
    "android:init": "npx cap add android && node scripts/patch-android.mjs && npx capacitor-assets generate --android && npx cap sync android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "build:apk": "bash build-apk.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0"
  }
}
